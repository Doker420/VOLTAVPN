# Application Secret & Port
FLASK_SECRET_KEY=volta-secret-key-2026-replace-me
PORT=5001

# Telegram Bot & Admin IDs
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
BOT_USERNAME=your_bot_username_without_at
ADMIN_TELEGRAM_IDS=123456789,987654321

# Support Contacts
SUPPORT_EMAIL=support@vpn.stas-max.ru
SUPPORT_TELEGRAM=@ILSupport

# Webhook Domain URL (Public HTTPS domain for Webhooks & Deep Links)
WEBHOOK_URL=https://vpn.stas-max.ru

# Russian reachability checks use the free Check-Host API (no proxy required).
RUSSIA_CHECK_HOST=true

# ЮMoney (YooMoney) P2P & Webhook
YOOMONEY_RECEIVER=4100118544926615
YOOMONEY_NOTIFICATION_SECRET=your_yoomoney_notification_secret
YOOMONEY_TOKEN=your_yoomoney_oauth_token

# Platega.io Gateway (Optional)
PLATEGA_MERCHANT_ID=your-merchant-id-uuid
PLATEGA_SECRET=your-api-secret

# CryptoBot Telegram Gateway (Optional)
CRYPTOBOT_API_TOKEN=your-cryptobot-token

# Обязательная подписка на Telegram-канал (ОП)
REQUIRED_CHANNEL=@my_channel
REQUIRED_CHANNEL_URL=https://t.me/my_channel

# Партнёрская программа (Реферальные отчисления)
AFFILIATE_COMMISSION_PERCENT=75
MIN_WITHDRAWAL_AMOUNT=100

# Database
DATABASE_URL=sqlite:///vpnhub.db
